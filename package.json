{
  "name": "orbit-finance",
  "version": "1.0.0",
  "description": "Local-first personal finance app: accounts, transactions, cost centers, reports, and AI-assisted statement imports on your own PostgreSQL.",
  "license": "MIT",
  "keywords": [
    "finance",
    "personal-finance",
    "budgeting",
    "self-hosted",
    "local-first",
    "nextjs",
    "postgresql",
    "bank-statements",
    "ollama"
  ],
  "homepage": "https://github.com/andreasawires/orbit-finance#readme",
  "bugs": {
    "url": "https://github.com/andreasawires/orbit-finance/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreasawires/orbit-finance.git"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "start:docker": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "worker": "node --env-file-if-exists=.env --import tsx workers/import-worker.ts",
    "release:patch": "npm version patch -m \"Release v%s\"",
    "release:minor": "npm version minor -m \"Release v%s\"",
    "release:major": "npm version major -m \"Release v%s\"",
    "package:node": "sh scripts/package-node-release.sh"
  },
  "dependencies": {
    "@firecrawl/pdf-inspector": "^1.25.2",
    "csv-parse": "^7.0.3",
    "lucide-react": "^0.468.0",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "pg-boss": "^12.26.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.3",
    "tsx": "^4.23.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.4.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "$sharp"
  }
}
