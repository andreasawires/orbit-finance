POSTGRES_DB=orbit_finance
POSTGRES_USER=orbit
POSTGRES_PASSWORD=orbit
POSTGRES_PORT=5433
DATABASE_URL=postgresql://orbit:orbit@localhost:5433/orbit_finance
DATABASE_URL_DOCKER=postgresql://orbit:orbit@database:5432/orbit_finance

WEB_PORT=3000

# Required by pdf-inspector inside Docker, including on Apple Silicon hosts.
APP_PLATFORM=linux/amd64

# Host-native runs store documents here; Compose uses its local named volume.
IMPORT_STORAGE_PATH=./data/imports

# Import size limits are in MiB; image complexity limits are in megapixels.
IMPORT_MAX_PDF_MB=25
IMPORT_MAX_PDF_PAGES=50
IMPORT_MAX_CSV_MB=10
IMPORT_MAX_CSV_ROWS=50000
IMPORT_MAX_CSV_COLUMNS=100
IMPORT_MAX_IMAGE_MB=10
IMPORT_MAX_IMAGE_MEGAPIXELS=20
IMPORT_MAX_RENDERED_MEGAPIXELS=4
IMPORT_WORKER_CONCURRENCY=1

# Host development uses loopback; Compose reaches the host through Docker's alias.
# Documents are never sent to a hosted API.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434
VISION_MODEL=qwen3-vl:4b-instruct
VISION_CONTEXT_SIZE=8192
VISION_MAX_INPUT_CHARS=24000
VISION_TIMEOUT_MS=120000

# Fully Dockerized Ollama modes set OLLAMA_BASE_URL_DOCKER to the selected
# service. See README for the exact CPU and NVIDIA commands.
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_PORT=11434
