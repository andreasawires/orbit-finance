POSTGRES_DB=orbit_finance
POSTGRES_USER=orbit
POSTGRES_PASSWORD=orbit
POSTGRES_PORT=5433
DATABASE_URL=postgresql://orbit:orbit@localhost:5433/orbit_finance
DATABASE_URL_DOCKER=postgresql://orbit:orbit@database:5432/orbit_finance

WEB_PORT=3000
# Bind the web UI to all interfaces for LAN access. Use 127.0.0.1 to keep it local.
WEB_BIND_ADDRESS=0.0.0.0

# Required by pdf-inspector inside Docker, including on Apple Silicon hosts.
APP_PLATFORM=linux/amd64

# Host-native runs store documents here; Compose uses its local named volume.
IMPORT_STORAGE_PATH=./data/imports

# Import size limits are in MiB; image complexity limits are in megapixels.
IMPORT_MAX_PDF_MB=25
IMPORT_MAX_PDF_PAGES=50
IMPORT_MAX_CSV_MB=10
IMPORT_MAX_CSV_ROWS=50000
IMPORT_MAX_CSV_COLUMNS=100
IMPORT_MAX_IMAGE_MB=10
IMPORT_MAX_IMAGE_MEGAPIXELS=20
IMPORT_MAX_RENDERED_MEGAPIXELS=4
IMPORT_WORKER_CONCURRENCY=1

# An OpenAI Chat Completions-compatible endpoint. MODEL_BASE_URL must end in
# /v1. MODEL_API_KEY is optional for self-hosted endpoints.
MODEL_BASE_URL=https://api.example.com/v1
# Leave empty for self-hosted endpoints that do not require authentication.
MODEL_API_KEY=
MODEL_NAME=your-vision-model
MODEL_STRUCTURED_OUTPUT=auto
MODEL_TIMEOUT_MS=300000
MODEL_MAX_INPUT_CHARS=24000

# Required when MODEL_BASE_URL does not point to localhost, 127.0.0.1, ::1, or
# host.docker.internal (the Docker host gateway).
# Enabling this acknowledges that imported statement contents are sent to the
# configured external model provider.
MODEL_ALLOW_REMOTE=false
