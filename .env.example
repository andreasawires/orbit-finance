# How this copy was installed: docker, node, or source (empty = docker inside
# Compose, source otherwise). Only used to show the
# right update command in the update banner. The installer sets it for you.
INSTALL_METHOD=

# Docker image tag to run (ghcr.io/andreasawires/orbit-finance:<ORBIT_VERSION>).
# Pin a version such as 1.0.0; `install.sh update` moves it forward.
ORBIT_VERSION=latest
# Optional Compose services: "db" adds the bundled Postgres, "proxy" adds Caddy
# with automatic HTTPS. Comma-separated; leave empty to run only the app.
COMPOSE_PROFILES=db
# Public domain for the "proxy" profile. DNS must point at this host.
ORBIT_DOMAIN=

# Bundled Postgres ("db" profile). The password is only applied when the volume
# is first created. Replace the placeholder; `openssl rand -hex 24` works well.
POSTGRES_DB=orbit_finance
POSTGRES_USER=orbit
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_PORT=5433
# Used by Docker Compose and by host-native commands.
# Bundled Postgres inside Compose: host `database`, port 5432.
# Host-native app against the published port: host `localhost`, port POSTGRES_PORT.
# A remote URL works from both Docker and the host.
DATABASE_URL=postgresql://orbit:change-me-to-a-long-random-password@database:5432/orbit_finance

WEB_PORT=3000
# Bind the web UI to all interfaces for LAN access. Use 127.0.0.1 to keep it local
# (recommended with the "proxy" profile, so only Caddy is reachable from outside).
WEB_BIND_ADDRESS=0.0.0.0

# Update check: once at startup and every 24 hours the server downloads this
# static JSON file with a plain GET (no identifiers or usage data are sent) and
# shows a banner when a newer release exists. Nothing is installed automatically.
# Set UPDATE_CHECK=false to turn it off entirely.
UPDATE_CHECK=true
UPDATE_MANIFEST_URL=https://andreasawires.github.io/orbit-finance/latest.json

# Optional: force the image architecture (linux/amd64 or linux/arm64). Leave
# unset to use the host's native architecture.
# APP_PLATFORM=linux/amd64

# Host-native runs store documents here; Compose uses its local named volume.
IMPORT_STORAGE_PATH=./data/imports

# Import size limits are in MiB; image complexity limits are in megapixels.
IMPORT_MAX_PDF_MB=25
IMPORT_MAX_PDF_PAGES=50
IMPORT_MAX_CSV_MB=10
IMPORT_MAX_CSV_ROWS=50000
IMPORT_MAX_CSV_COLUMNS=100
IMPORT_MAX_IMAGE_MB=10
IMPORT_MAX_IMAGE_MEGAPIXELS=20
IMPORT_MAX_RENDERED_MEGAPIXELS=4
IMPORT_WORKER_CONCURRENCY=1

# An OpenAI Chat Completions-compatible endpoint. MODEL_BASE_URL must end in
# /v1. MODEL_API_KEY is optional for self-hosted endpoints.
MODEL_BASE_URL=https://api.example.com/v1
# Leave empty for self-hosted endpoints that do not require authentication.
MODEL_API_KEY=
MODEL_NAME=your-vision-model
MODEL_STRUCTURED_OUTPUT=auto
MODEL_TIMEOUT_MS=300000
# Reasoning for models that support it, sent as OpenRouter's `reasoning` field:
# off, low, medium, or high. "provider" sends nothing (use it for endpoints that
# reject unknown fields). Extraction is transcription, so "off" is much faster.
MODEL_REASONING=provider
# PDF pages are grouped into requests of about MODEL_BATCH_CHARS characters,
# and up to MODEL_CONCURRENCY requests run at once.
MODEL_BATCH_CHARS=12000
MODEL_CONCURRENCY=4
# Maximum combined native-PDF text sent in one model request. Set this below
# your model's usable context window, leaving room for the importer prompt,
# JSON schema, and the model's transaction output.
MODEL_MAX_INPUT_CHARS=24000

# Required when MODEL_BASE_URL does not point to localhost, 127.0.0.1, ::1, or
# host.docker.internal (the Docker host gateway).
# Enabling this acknowledges that imported statement contents are sent to the
# configured external model provider.
MODEL_ALLOW_REMOTE=false
